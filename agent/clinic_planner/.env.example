# Copy to .env (agent/run_local.sh does this for you). adk web / adk run load it.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini 3.x is served from the global endpoint. If the model is "not found", try us-central1.
GOOGLE_CLOUD_LOCATION=global
A4I_MODEL=gemini-3.6-flash
A4I_DATASET=a4i_health
TOOLBOX_URL=http://127.0.0.1:5000
